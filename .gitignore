# Raw downloads and PDFs are not committed
data/raw/*
!data/raw/.gitkeep
*.pdf
data/processed/*
!data/processed/.gitkeep
# Small derived outputs are tracked (Amendment A3)
!data/processed/parameters.json
!data/processed/imports_*.csv
!data/processed/README.md
# Phase 2 summary outputs are tracked (Amendment A5); all are under 15 kB.
!data/processed/rq1_*.csv
!data/processed/rq2_*.csv
# Large per-draw Monte Carlo outputs are never tracked (none are written at present).
data/processed/*_draws*
*.npy
*.npz

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Private extracts from restricted sources (not committed)
data/interim/private/

# Phase 1b record-level UN Comtrade extract (not tracked; see docs/analysis_plan.md §12, Amendment A4).
# data/interim/phase0_comtrade_availability.csv is tracked under the small-extract exemption.
data/interim/phase1b_comtrade_early_availability.csv
